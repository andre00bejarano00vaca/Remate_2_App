{
  "expo": {
    "name": "PRE-LANCE FERCOGAN",
    "slug": "remate-ganadero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para funcionalidades del remate ganadero",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para funcionalidades del remate ganadero"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.andre_bejarano.remateganadero"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6a959546-9ae1-4f01-9133-6c355f837964"
      },
      "apiBaseUrl": "https://testapp.digitaltelecom.net",
      "wsBaseUrl": "wss://testapp.digitaltelecom.net"
    }
  }
}
